PORT=3000
NODE_ENV=production
APP_VERSION=1.0.0
JSON_LIMIT=5mb
MAX_STROKE_POINTS=4000
MAX_ROOM_STROKES=10000
MAX_STICKY_NOTES=500
MAX_CHAT_MESSAGES=200
ROOM_TTL_MS=14400000
DISCONNECT_GRACE_MS=45000
WS_MAX_PAYLOAD_BYTES=2097152

# Required for AI word generation
GEMINI_API_KEY="YOUR_GEMINI_KEY"

# Public URL used for share links and room invites
APP_URL="https://your-public-domain.com"
